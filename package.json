{
  "name": "madden-editor-suite",
  "productName": "madden-editor-suite",
  "version": "3.2.1",
  "description": "Professional Madden NFL file editor with 17+ specialized tools for roster, franchise, and visual customization",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "npm run package && electron-builder --config electron-builder.yml --prepackaged \"out/Madden Editor Suite-win32-x64\"",
    "dist:simple": "npm run package && electron-builder build -w --prepackaged \"out/Madden Editor Suite-win32-x64\"",
    "zip": "cd out && \"C:\\Program Files\\7-Zip\\7z.exe\" a -tzip -mx5 \"../dist/Madden-Editor-Suite-Portable.zip\" \"Madden Editor Suite-win32-x64\"",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "lint:fix": "eslint --ext .ts,.tsx . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "npm run start",
    "build": "npm run typecheck && npm run lint && npm run test && npm run dist",
    "clean": "rimraf dist out coverage .vite",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild-db": "npm rebuild better-sqlite3 && node scripts/create-database.js && electron-rebuild -f -w better-sqlite3",
    "prepackage": "electron-rebuild -f -w better-sqlite3",
    "predist": "electron-rebuild -f -w better-sqlite3",
    "predist:simple": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [],
  "author": {
    "name": "tshanks1027",
    "email": "98771803+tshanks1027@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tshanks1027/Madden-Editor-Suite.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron-forge/plugin-vite": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.21",
    "electron": "38.1.2",
    "electron-builder": "^26.0.12",
    "electron-forge-maker-nsis": "^26.0.12",
    "eslint": "^8.57.1",
