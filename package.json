    "@types/puppeteer": "^5.4.7",
    "@types/sqlite3": "^3.1.11",
    "@types/three": "^0.180.0",
    "ag-grid-community": "^34.3.1",
    "better-sqlite3": "^12.6.2",
    "bit-buffer": "^0.2.5",
    "canvas": "^3.2.0",
    "crc-32": "^1.2.2",
    "decode-dxt": "^1.0.1",
    "electron-squirrel-startup": "^1.0.1",
