{
  "permissions": {
    "allow": [
      "Bash(tasklist:*)",
      "Bash(node -e:*)",
      "Bash(xcopy:*)",
      "Bash(node:*)",
      "Bash(dir \"C:\\Users\\tshan\\Downloads\\PAM\\Gamemode\")",
      "Bash(dir:*)",
      "Bash(timeout 15 npm start)",
      "Bash(timeout 20 npm start)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(npm ls:*)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:www.footballidiot.com)",
      "WebFetch(domain:forums.operationsports.com)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Bash(timeout 30 npm start)",
      "Bash(npm version:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm run package:*)",
      "Bash(npm run dist:simple:*)",
      "Bash(cmd //c \"taskkill /F /IM \"\"Madden Editor Suite.exe\"\"\")",
      "Bash(cmd //c \"rd /s /q out\")"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/load-workflow.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/require-plan.ps1 -ToolName $TOOL_NAME"
          }
        ]
      }
    ]
  }
}
